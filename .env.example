# UPS-ECO-SYSTEM · Environment variables

# Backend Core
HTTP_PORT=8080
DATABASE_URL=postgres://ups:ups_secret@localhost:5432/ups_eco?sslmode=disable
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=upsminio
S3_SECRET_KEY=upsminio_secret
S3_BUCKET=ups-files

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=ups
CLICKHOUSE_PASSWORD=ups_secret
CLICKHOUSE_DB=ups_analytics

# Frontend
PUBLIC_API_URL=http://localhost:8080/api/v1
